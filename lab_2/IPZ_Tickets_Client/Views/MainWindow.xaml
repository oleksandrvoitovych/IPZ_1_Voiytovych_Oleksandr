<Window x:Class="IPZ_Tickets_Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IPZ_Tickets_Client.ViewModels"
        Title="Продаж автобусних квитків" Height="500" Width="800">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical" Margin="4">
                <TextBlock Text="Звідки:"/>
                <TextBox Width="140" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="4">
                <TextBlock Text="Куди:"/>
                <TextBox Width="140" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="4">
                <TextBlock Text="Дата:"/>
                <DatePicker SelectedDate="{Binding Date}" Width="140"/>
            </StackPanel>
            <Button Content="Пошук" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" VerticalAlignment="Bottom" Margin="8"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedTicket}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Від" Binding="{Binding From}" Width="100"/>
                <DataGridTextColumn Header="До" Binding="{Binding To}" Width="100"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="100"/>
                <DataGridTextColumn Header="Час" Binding="{Binding Time}" Width="80"/>
                <DataGridTextColumn Header="Місце" Binding="{Binding Seat}" Width="70"/>
                <DataGridTextColumn Header="Ціна" Binding="{Binding Price}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Забронювати" Style="{StaticResource PrimaryButton}" Command="{Binding OpenBookingCommand}" />
        </StackPanel>
    </Grid>
</Window>
